[constants]
ohos_llvm_bin = '${ohos_native_llvm_path}/bin'

[binaries]
c = ohos_llvm_bin / 'clang.exe'
cpp = ohos_llvm_bin / 'clang++.exe'
ar = ohos_llvm_bin / 'llvm-ar.exe'
strip = ohos_llvm_bin / 'llvm-strip.exe'

[properties]
c_args = '-target x86_64-linux-ohos'
c_link_args = '-target x86_64-linux-ohos'

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'