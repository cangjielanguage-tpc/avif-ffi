[constants]
ohos_llvm_bin = 'D:/DevecoStudio51/DevEcoStudio/sdk/default/openharmony/native/llvm/bin'

[binaries]
c = ohos_llvm_bin / 'clang'
cpp = ohos_llvm_bin / 'clang++'
ar = ohos_llvm_bin / 'llvm-ar'
strip = ohos_llvm_bin / 'llvm-strip'

[properties]
c_args = '-target x86_64-linux-ohos'
c_link_args = '-target x86_64-linux-ohos'

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'