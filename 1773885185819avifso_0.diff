-        }
-
-        int minQuantizer;
-        int maxQuantizer;
-        if (alpha) {
-            minQuantizer = encoder->minQuantizerAlpha;
-            maxQuantizer = encoder->maxQuantizerAlpha;
-        } else {
-            minQuantizer = encoder->minQuantizer;
-            maxQuantizer = encoder->maxQuantizer;
