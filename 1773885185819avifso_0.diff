-        AVIF_CHECKRES(avifCheckCodecVersionAVM());
-
-        int aomCpuUsed = -1;
-        if (encoder->speed != AVIF_SPEED_DEFAULT) {
-            aomCpuUsed = AVIF_CLAMP(encoder->speed, 0, 9);
-        }
-
