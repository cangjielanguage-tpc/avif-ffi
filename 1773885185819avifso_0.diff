-    if (codec == NULL) {
-        return NULL;
-    }
-    memset(codec, 0, sizeof(struct avifCodec));
-    codec->encodeImage = svtCodecEncodeImage;
-    codec->encodeFinish = svtCodecEncodeFinish;
-    codec->destroyInternal = svtCodecDestroyInternal;
