-    // Next see if it can be parsed as a string.
-    for (listptr = enums; listptr->name; listptr++) {
-        if (!strcmp(str, listptr->name)) {
-            *val = listptr->val;
-            return AVIF_TRUE;
-        }
-    }
-
-    return AVIF_FALSE;
-}
